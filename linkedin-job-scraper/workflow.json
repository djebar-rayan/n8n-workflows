    {
      "parameters": {
        "jsCode": "const itemsArray = Array.isArray(items) ? items : [];\nconst nbJobs = itemsArray.length;\n\n// Try to recover the form trigger email from the first item:\nlet email = '';\nif (nbJobs > 0 && itemsArray[0].json && itemsArray[0].json[\"Email\"]) {\n  email = itemsArray[0].json[\"Email\"];\n}\n\nconst htmlJobs = itemsArray.map(item => `\n  <div class=\"job-card\">\n    <div class=\"job-header\">\n      <h2 class=\"job-title\">\n        <a href=\"${item.json.Lien_Job}\" target=\"_blank\">${item.json.Titre_Job}</a>\n      </h2>\n      <div class=\"company-name\">${item.json.Nom_Entreprise}</div>\n      <div class=\"job-meta\">\n        <span class=\"meta-item\">📍 ${item.json.Localisation}</span>\n        <span class=\"meta-item\">⏰ ${item.json.Date_du_poste}</span>\n        ${item.json.Type_Emploi ? `<span class=\"meta-item\">💼 ${item.json.Type_Emploi}</span>` : ''}\n        ${item.json.Niveau_Requis ? `<span class=\"meta-item\">📊 ${item.json.Niveau_Requis}</span>` : ''}\n      </div>\n    </div>\n    <div class=\"job-description\">${item.json.Job_Description_Html}</div>\n    <div class=\"btn-container\" style=\"text-align:center;margin-top:20px;\">\n      <a href=\"${item.json.Lien_Job}\" class=\"btn-apply\" target=\"_blank\" style=\"display:inline-block;background:#0077B5;color:white;padding:12px 30px;border-radius:25px;text-decoration:none;font-weight:600;\">\n        View on LinkedIn →\n      </a>\n    </div>\n  </div>\n`).join('\\n');\n\nreturn [\n  {\n    json: {\n      nbJobs: nbJobs,\n      allJobsHtml: htmlJobs,\n      emailTrigger: $('Form Trigger').first().json[\"Email\"]  // <--- form submitter email\n    }\n  }\n];\n"
      },
