    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // JobType label → LinkedIn API single-letter code\n  let code;\n  switch (item.json.JobType) {\n    case \"Full-time\":\n      code = \"F\";\n      break;\n    case \"Part-time\":\n      code = \"P\";\n      break;\n    case \"Contract\":\n      code = \"C\";\n      break;\n    case \"Internship\":\n      code = \"I\";\n      break;\n    default:\n      code = \"\";\n  }\n\n  // WorkSchedule label → LinkedIn API numeric code\n  let modeTravail;\n  switch (item.json.WorkSchedule) {\n    case \"On-site\":\n      modeTravail = \"1\";\n      break;\n    case \"Remote\":\n      modeTravail = \"2\";\n      break;\n    case \"Hybrid (on-site + remote)\":\n      modeTravail = \"3\";\n      break;\n    default:\n      modeTravail = \"1\";\n  }\n\n  // Return the enriched item\n  return {\n    json: {\n      ...item.json,\n      job_type: code,        // letter code for the API\n      work_schedule: modeTravail // numeric code for the API\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
